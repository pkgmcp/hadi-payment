parameters:
    level: 5
    paths:
        - src
    tmpDir: /tmp/opencode/phpstan
    stubFiles:
        - phpstan.stub
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # The gateway implementations ship with embedded mock/simulated response
        # handling inherited from the merged upstream libraries. Because the
        # mock payloads are statically known, checks for fields and status
        # values that exist only on real gateway responses produce expected
        # static-analysis noise. These are scoped to the Gateways directory.
        - identifier: 'nullCoalesce.offset'
          paths:
            - src/Gateways/*
        - identifier: 'empty.offset'
          paths:
            - src/Gateways/*
        - identifier: 'isset.offset'
          paths:
            - src/Gateways/*
        - identifier: 'offsetAccess.notFound'
          paths:
            - src/Gateways/*
        - identifier: 'nullCoalesce.expr'
          paths:
            - src/Gateways/*
        - identifier: 'notIdentical.alwaysFalse'
          paths:
            - src/Gateways/*
        - identifier: 'booleanOr.alwaysFalse'
          paths:
            - src/Gateways/*
        - identifier: 'identical.alwaysFalse'
          paths:
            - src/Gateways/*
        - identifier: 'identical.alwaysTrue'
          paths:
            - src/Gateways/*
        - identifier: 'booleanNot.alwaysFalse'
          paths:
            - src/Gateways/*
        - identifier: 'ternary.alwaysFalse'
          paths:
            - src/Gateways/*
        - identifier: 'greaterOrEqual.alwaysFalse'
          paths:
            - src/Gateways/*
        - identifier: 'booleanAnd.alwaysFalse'
          paths:
            - src/Gateways/*
        - identifier: 'notIdentical.alwaysTrue'
          paths:
            - src/Gateways/*
        - identifier: 'ternary.alwaysTrue'
          paths:
            - src/Gateways/*
        - identifier: 'smaller.alwaysFalse'
          paths:
            - src/Gateways/*
        - identifier: 'if.alwaysTrue'
          paths:
            - src/Gateways/*
        - identifier: 'booleanOr.alwaysTrue'
          paths:
            - src/Gateways/*
        - identifier: 'booleanAnd.alwaysTrue'
          paths:
            - src/Gateways/*
        - identifier: 'method.unused'
          paths:
            - src/Gateways/*
        - identifier: 'classConstant.unused'
          paths:
            - src/Gateways/*
        - identifier: 'catch.neverThrown'
          paths:
            - src/Gateways/*
        # $http_response_header is populated by file_get_contents in this scope.
        - identifier: 'nullCoalesce.variable'
          paths:
            - src/PaymentGateway.php
