{
    "name": "hadi/hadi-payment",
    "description": "A comprehensive multi-gateway payment package for PHP 8.4+ and Laravel 13/14. Unified API for 1900+ payment gateways across all 195 countries including bKash, Nagad, Binance Pay, PayPal, Stripe, Razorpay, Paytm, and more. Dedicated to Sharif Osman Bin Hadi.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "payment",
        "gateway",
        "laravel",
        "php",
        "bkash",
        "nagad",
        "binance",
        "paypal",
        "stripe",
        "razorpay",
        "paytm",
        "sslcommerz",
        "rocket",
        "upay",
        "surecash",
        "mcash",
        "mycash",
        "ucash",
        "aamarpay",
        "shurjopay",
        "multipay",
        "multipayment",
        "countries",
        "country-catalog",
        "195-countries",
        "bangladesh",
        "india",
        "hadi"
    ],
    "homepage": "https://github.com/hadi/hadi-payment",
    "authors": [
        {
            "name": "Hadi Payment",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0|^14.0",
        "guzzlehttp/guzzle": "^7.8",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "ext-hash": "*",
        "ext-gd": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Hadi\\Payment\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Hadi\\Payment\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hadi\\Payment\\HadiPaymentServiceProvider"
            ],
            "aliases": {
                "HadiPayment": "Hadi\\Payment\\Facades\\HadiPayment",
                "PaymentGateway": "Hadi\\Payment\\Facades\\PaymentGateway"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "stan": "phpstan analyse src --level=5",
        "cs": "phpcs --runtime-set ignore_warnings_on_exit 1",
        "cs-fix": "phpcbf src --standard=PSR12",
        "optimize": "composer dump-autoload --optimize"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
